{
  "name": "@m-sanchez/silent-zero",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Unknown is not zero: an eval for proving absence in very large data. Five kinds of zero, one checklist that tells them apart.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CLAIMS.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node demo/demo.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-sanchez/silent-zero.git"
  },
  "homepage": "https://miguelsanchez.co.uk/writing/the-silent-zero-proving-absence/",
  "author": "Miguel Sanchez <contact@miguelsanchez.co.uk>",
  "license": "MIT",
  "keywords": [
    "evals",
    "llm",
    "data-quality",
    "epistemics",
    "absence",
    "coverage",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0"
  },
  "types": "./dist/index.d.ts"
}
